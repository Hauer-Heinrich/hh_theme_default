mod {
    web_list {
        listOnlyInSingleTableView = 0
        allowedNewTables = tx_powermail_domain_model_form
        hideTables = tx_powermail_domain_model_page, tx_powermail_domain_model_field, tt_content
    }
}

TCEFORM {
    tx_powermail_domain_model_form {
        css {
            removeItems = layout1, layout2, layout3
        }
    }
    tx_powermail_domain_model_page {
        css {
            removeItems = layout1,layout2,layout3
            addItems {
                nolabel-noborder = Hide label and border
            }
        }
    }
    tx_powermail_domain_model_field {
        css {
            removeItems = layout1,layout2,layout3
        }
    }
}
