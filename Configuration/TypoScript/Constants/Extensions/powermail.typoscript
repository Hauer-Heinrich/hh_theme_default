################################################################
### Form - powermail ###
################################################################
@import 'EXT:powermail/Configuration/TypoScript/Main/constants.typoscript'

plugin.tx_powermail {
    settings {
        styles {
            framework {
                numberOfColumns =
                rowClasses =
                fieldWrappingClasses = field
                fieldAndLabelWrappingClasses = field-wrap
                submitClasses = btn btn-default btn-primary btn-submit
            }
        }
    }
}
