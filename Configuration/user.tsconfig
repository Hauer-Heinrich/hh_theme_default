### https://docs.typo3.org/m/typo3/reference-tsconfig/main/en-us/UserTsconfig/Options.html#foldertree-uploadfieldsinlinkbrowser
options {
    clearCache.pages = 1
    folderTree.uploadFieldsInLinkBrowser = 0
    enableBookmarks = 1

    pageTree {
        showDomainNameWithTitle = 1
        showPageIdWithTitle = 1
    }
}

### MFA
auth {
    mfa {
        recommendedProvider = yubikey
        disableProviders := addToList(recovery-codes)
        disableProviders := addToList(totp)
    }
}

admPanel {
    enable {
        all = 0
        preview = 1
        cache = 0
        publish = 0
        edit = 0
        tsdebug = 0
        info = 0
    }

    override {
        edit {
            displayFieldIcons = 0
            displayIcons = 0
        }
        preview {
            showFluidDebug = 0
            showHiddenPages = 1
            showHiddenRecords = 1
        }

        cache.noCache = 1
    }

    hide = 0
}

[backend.user.isAdmin == "0"]
    options {
        hideModules = site_configuration
    }
[GLOBAL]

### Hide fields e. g. in filelist
page.TCEFORM {
    sys_file_metadata {
        ranking.disabled = 1
        keywords.disabled = 1
        creator_tool.disabled = 1
    }
}
