{
    "type": "typo3-cms-extension",
    "name": "hauerheinrich/hh-theme-default",
    "description": "Distribution theme: Anpassbar im Backend im Konstanten Editor.",
    "keywords": [ "TYPO3 CMS", "TYPO3", "theme", "distribution", "extension" ],
    "homepage": "https://www.hauer-heinrich.de",
    "readme": "README.md",
    "time": "2026-01-09",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Christian Hackl",
            "homepage": "https://www.hauer-heinrich.de",
            "role": "Developer"
        },
        {
            "name": "Martin Hofmann",
            "homepage": "https://www.hauer-heinrich.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Hauer-Heinrich/hh_theme_default/issues",
        "source": "https://github.com/Hauer-Heinrich/hh_theme_default",
        "docs": "https://github.com/Hauer-Heinrich/hh_theme_default/blob/master/README.md"
    },
    "funding": [
        {
            "type": "paypal",
            "url": "https://www.paypal.com/paypalme/hauerheinrich"
        }
    ],
    "replace": {
        "typo3-ter/hh-theme-default": "self.version"
    },
    "require": {
        "typo3/cms-core": "^13.4.0",
        "typo3/cms-extbase": "^13.4.0",
        "typo3/cms-fluid": "^13.4.0",
        "typo3/cms-frontend": "^13.4.0",
        "typo3/cms-fluid-styled-content": "^13.4.0",
        "typo3/cms-scheduler": "^13.4.0",
        "typo3/cms-seo": "^13.4.0",
        "typo3/cms-rte-ckeditor": "^13.4.0",
        "typo3/cms-filemetadata": "^13.4.0",
        "typo3/cms-indexed-search": "^13.4.0",
        "hauerheinrich/hh-ckeditor-font": ">1.0.0",
        "b13/container": ">=2.3.0",
        "friendsoftypo3/tt-address": ">=10.0.0",
        "hauerheinrich/hh-simple-job-posts": ">=5.2.1",
        "hauerheinrich/hh-accordion": ">=0.7.2",
        "georgringer/news": ">=14.0.0",
        "in2code/powermail": ">=13.1.0",
        "hauerheinrich/hh-powermail-checkboxlink": ">=0.2.2",
        "hauerheinrich/hh-slider": ">=1.1.0",
        "hauerheinrich/hh-seo": ">=0.11.0"
    },
    "suggest": {
        "hauerheinrich/hh-tt-address-places": ">=5.1.0",
        "hauerheinrich/hh-video-extender": ">=0.5.0",
        "hauerheinrich/hh_openstreetmap": ">=1.2.0",
        "hauerheinrich/typo3-monitor-api": ">=1.5.2",
        "hauerheinrich/hh-widget-hhnews": ">=1.2.1"
    },
    "autoload": {
        "psr-4": {
            "HauerHeinrich\\HhThemeDefault\\": "Classes"
        }
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/Web",
            "extension-key": "hh_theme_default",
            "version": "1.0.0",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
